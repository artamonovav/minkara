# Скопируйте в config/settings.local.env и поправьте под себя.
# Файл settings.local.env в git не попадает.

# --- сеть ---
# Пауза между запросами, секунды (robots.txt: Crawl-delay 1)
MINKARA_DELAY=1.0
MINKARA_TIMEOUT=30
MINKARA_RETRIES=4

# --- каталоги (по умолчанию — внутри репозитория) ---
# MINKARA_DATA_DIR=/path/to/data
# MINKARA_OUT_DIR=/path/to/out
# MINKARA_WORK_DIR=/path/to/work

# --- перевод ---
# echo   — заглушка, ничего не переводит (для проверки пайплайна)
# openai — любой OpenAI-совместимый API
MINKARA_TRANSLATE_PROVIDER=echo
MINKARA_TRANSLATE_BASE_URL=https://api.openai.com/v1
MINKARA_TRANSLATE_API_KEY=
MINKARA_TRANSLATE_MODEL=
